# Server env (loaded when running from /server).
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/takashi_photos
CLOUD_NAME=YOUR_CLOUDINARY_CLOUDNAME
API_KEY=YOUR_CLOUDINARY_API_KEY
API_SECRET=YOUR_CLOUDINARY_API_SECRET
CLOUDINARY_NOTIFICATION_URL=YOUR_CLOUDINARY_NOTIFICATION_URL
IMAGE_IMPORT_DIR=PATH_TO_LOCAL_IMAGES
BETTER_AUTH_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
BETTER_AUTH_URL=http://localhost:3000
AUTH_EMAIL=admin@example.com
AUTH_PASSWORD=CHANGE_ME
AUTH_PASSWORD_HASH=YOUR_BCRYPT_HASH
AUTH_JWT_SECRET=OPTIONAL_FALLBACK_IF_BETTER_AUTH_SECRET_IS_UNSET
AUTH_SESSION_TTL_DAYS=7
AUTH_SMOKE_EMAIL=admin@example.com
AUTH_SMOKE_PASSWORD=CHANGE_ME
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
